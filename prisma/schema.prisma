generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model MotionEvent {
  id        Int      @id @default(autoincrement())
  motion    Boolean  
  catName   String
  camName   String
  actuated  Boolean
  timestamp DateTime @default(now())
}